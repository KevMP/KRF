{
  "name": "krf",
  "version": "1.0.0",
  "description": "Kevin's Roblox Framework: a server-authoritative Luau gameplay framework with Actors, Tags, Properties, Resources, Actions, and schema-defined replication.",
  "scripts": {
    "prepare": "husky",
    "typecheck": "node ./scripts/typecheck.cjs",
    "test:lint": "stylua --check src tests && breathers --check src tests && selene src tests",
    "test:unit": "powershell -ExecutionPolicy Bypass -File ./scripts/test.ps1 && npm run coverage",
    "test:integration:n5": "powershell -ExecutionPolicy Bypass -File ./scripts/test-n5-native.ps1",
    "test:integration:n6": "powershell -ExecutionPolicy Bypass -File ./scripts/test-n6-native.ps1",
    "test:integration:n7": "powershell -ExecutionPolicy Bypass -File ./scripts/test-n7-native.ps1",
    "test:integration:tags-load": "powershell -ExecutionPolicy Bypass -File ./scripts/test-tags-load.ps1",
    "measure:tags": "powershell -ExecutionPolicy Bypass -File ./scripts/measure-tags-publication.ps1",
    "measure:networking": "powershell -ExecutionPolicy Bypass -File ./scripts/measure-networking-baseline.ps1",
    "measure:n4": "powershell -ExecutionPolicy Bypass -File ./scripts/measure-n4-performance.ps1",
    "test:integration:n4-performance": "powershell -ExecutionPolicy Bypass -File ./scripts/measure-n4-performance.ps1 -Profile Native",
    "test:integration:networking-baseline": "powershell -ExecutionPolicy Bypass -File ./scripts/test-networking-baseline.ps1",
    "coverage:prepare": "node ./scripts/prepare-nyc-coverage.cjs",
    "coverage:report": "npx nyc report",
    "coverage:check": "npx nyc check-coverage",
    "coverage": "npm run coverage:prepare && npm run coverage:report && npm run coverage:check",
    "test": "npm run test:lint && npm run typecheck && npm run test:unit"
  },
  "lint-staged": {
    "*.{lua,luau}": [
      "stylua",
      "breathers"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KevMP/KRF.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/KevMP/KRF/issues"
  },
  "homepage": "https://github.com/KevMP/KRF#readme",
  "nyc": {
    "temp-dir": ".nyc_output",
    "report-dir": "coverage",
    "extension": [
      ".luau",
      ".lua"
    ],
    "reporter": [
      "html",
      "lcovonly",
      "json-summary",
      "cobertura",
      "text-summary",
      "text"
    ],
    "all": true,
    "per-file": true,
    "branches": 90,
    "functions": 90,
    "lines": 90,
    "statements": 90
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nyc": "^17.1.0"
  }
}
