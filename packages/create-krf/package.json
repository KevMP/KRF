{
  "name": "create-krf",
  "version": "0.1.0",
  "description": "Create a KRF Roblox game project: npm create krf@latest",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KevMP/KRF.git",
    "directory": "packages/create-krf"
  },
  "homepage": "https://kevmp.github.io/KRF/",
  "bugs": {
    "url": "https://github.com/KevMP/KRF/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "create-krf": "bin/create-krf.js"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node scripts/skill-docs.js",
    "postpack": "node scripts/skill-docs.js --clean",
    "test": "node --test \"tests/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test:configurations": "node --test \"tests/configurations/*.test.js\""
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "@kevmp/krf-tools": "0.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@msgpack/msgpack": "3.1.3"
  }
}
